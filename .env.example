# Copy to .env and fill in. Both agents read this file via python-dotenv.

# LiveKit project credentials. From the LiveKit Cloud dashboard, or from your
# self-hosted server config. Needed by both agents, and by the cascade agent's
# LiveKit Inference calls (STT, LLM, TTS, turn detection all bill through these).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI key. Needs GPT-Live access on the account for the gptlive agent.
# The cascade agent does not use this directly: it reaches OpenAI through
# LiveKit Inference with the slug openai/gpt-4.1-mini.
OPENAI_API_KEY=
